<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MGK-Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Share+Tech+Mono&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
<style>
  :root {
    --bg: #000000;
    --bg2: #080808;
    --bg3: #0f0f0f;
    --accent: #00f5ff;
    --accent2: #7c3aed;
    --accent3: #10b981;
    --text: #e2e8f0;
    --muted: #64748b;
    --border: rgba(0,245,255,0.15);
    --glow: 0 0 20px rgba(0,245,255,0.3);
    --glow2: 0 0 20px rgba(124,58,237,0.3);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ── PURE BLACK BACKGROUND ── */
  .stars-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background: #020817;
  }
  .stars-bg::before { display: none; }

  /* ── AURORA CURSOR EFFECT ── */
  .grid-overlay {
    position: fixed; inset: 0; z-index: 2; pointer-events: none;
    background: transparent;
    transition: none;
  }
  .aurora-layer {
    position: fixed; inset: 0; z-index: 2; pointer-events: none;
    background: transparent;
  }
  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 3rem;
    background: rgba(2,8,23,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo {
    font-family: 'Orbitron', monospace;
    font-weight: 700; font-size: 1.1rem;
    color: var(--accent);
    letter-spacing: 2px;
    text-shadow: 0 0 12px rgba(0,245,255,0.5);
  }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    font-family: 'Share Tech Mono', monospace;
    color: var(--muted); text-decoration: none;
    font-size: 0.85rem; letter-spacing: 1px;
    transition: color 0.3s, text-shadow 0.3s;
  }
  .nav-links a:hover { color: var(--accent); text-shadow: 0 0 8px rgba(0,245,255,0.5); }
  .nav-cta {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent) !important;
    padding: 0.4rem 1.2rem;
    border-radius: 2px;
  }
  .nav-cta:hover { background: rgba(0,245,255,0.08) !important; }

  /* ── MAIN CONTENT ── */
  main { position: relative; z-index: 1; }
  section { padding: 6rem 3rem; max-width: 1100px; margin: 0 auto; }

  /* ── HERO ── */
  #hero {
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: center;
    padding-top: 6rem; padding-bottom: 4rem;
    max-width: 1100px; margin: 0 auto;
  }
  .hero-tag {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.8rem; letter-spacing: 3px;
    color: var(--accent); margin-bottom: 1rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .hero-tag::before {
    content:''; display:inline-block; width:30px; height:1px;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }
  .hero-name {
    font-family: 'Orbitron', monospace;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900; line-height: 1.05;
    color: #fff;
    text-shadow: 0 0 40px rgba(0,245,255,0.2);
    margin-bottom: 0.5rem;
  }
  .hero-name span { color: var(--accent); text-shadow: 0 0 20px rgba(0,245,255,0.6); }
  .hero-title {
    font-family: 'Share Tech Mono', monospace;
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    color: var(--muted); margin-bottom: 1.5rem;
    letter-spacing: 2px;
  }
  .hero-title .typed-text { color: var(--accent2); }
  .cursor-blink {
    display: inline-block; width: 2px; height: 1.2em;
    background: var(--accent); vertical-align: middle;
    animation: blink 1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .hero-bio {
    font-size: 1rem; color: var(--muted); max-width: 560px;
    line-height: 1.8; margin-bottom: 2.5rem;
    border-left: 2px solid var(--accent2);
    padding-left: 1.25rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary {
    font-family: 'Share Tech Mono', monospace;
    background: var(--accent); color: #000;
    padding: 0.75rem 2rem; border: none; border-radius: 2px;
    font-size: 0.85rem; letter-spacing: 2px; cursor: pointer;
    text-decoration: none; display: inline-block;
    transition: all 0.3s; font-weight: 600;
    box-shadow: 0 0 20px rgba(0,245,255,0.4);
  }
  .btn-primary:hover { box-shadow: 0 0 40px rgba(0,245,255,0.6); transform: translateY(-2px); }
  .btn-secondary {
    font-family: 'Share Tech Mono', monospace;
    background: transparent; color: var(--text);
    padding: 0.75rem 2rem;
    border: 1px solid var(--border);
    border-radius: 2px; font-size: 0.85rem;
    letter-spacing: 2px; cursor: pointer;
    text-decoration: none; display: inline-block;
    transition: all 0.3s;
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .hero-stats {
    display: flex; gap: 3rem; margin-top: 4rem;
    border-top: 1px solid var(--border); padding-top: 2rem;
    flex-wrap: wrap;
  }
  .stat-item { text-align: center; }
  .stat-num {
    font-family: 'Orbitron', monospace; font-size: 2rem;
    font-weight: 700; color: var(--accent);
    text-shadow: 0 0 12px rgba(0,245,255,0.4);
  }
  .stat-label { font-size: 0.75rem; color: var(--muted); letter-spacing: 2px; margin-top: 0.25rem; }
  .hero-scroll {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    color: var(--muted); font-family: 'Share Tech Mono', monospace;
    font-size: 0.7rem; letter-spacing: 2px; animation: float 2s ease-in-out infinite;
  }
  @keyframes float { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(-8px)} }
  .scroll-line {
    width: 1px; height: 40px;
    background: linear-gradient(to bottom, var(--accent), transparent);
  }

  /* ── SECTION HEADERS ── */
  .section-header { margin-bottom: 3rem; }
  .section-tag {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.75rem; letter-spacing: 3px; color: var(--accent);
    margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.75rem;
  }
  .section-tag::before {
    content:'['; color: var(--accent2);
  }
  .section-tag::after {
    content:']'; color: var(--accent2);
  }
  .section-title {
    font-family: 'Orbitron', monospace;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700; color: #fff;
  }
  .section-line {
    width: 60px; height: 2px;
    background: linear-gradient(to right, var(--accent), var(--accent2));
    margin-top: 0.75rem;
    box-shadow: 0 0 8px rgba(0,245,255,0.4);
  }

  /* ── ABOUT ── */
  .about-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 4rem; align-items: start;
  }
  .about-grid > :last-child {
    position: sticky;
    top: 100px;
    align-self: start;
  }
  .about-text p { color: var(--muted); line-height: 1.9; margin-bottom: 1rem; }
  .about-text p strong { color: var(--accent); font-weight: 500; }
  .about-interests { margin-top: 2rem; }
  .interests-label {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.75rem; letter-spacing: 2px; color: var(--accent2);
    margin-bottom: 0.75rem;
  }
  .interest-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.75rem; padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 2px; color: var(--muted);
    transition: all 0.3s;
  }
  .tag:hover { border-color: var(--accent); color: var(--accent); background: rgba(0,245,255,0.05); }
  .about-terminal {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: var(--glow);
    position: relative; z-index: 1;
    will-change: transform;
  }
  .about-terminal:hover {
    border-color: rgba(0,245,255,0.4) !important;
    z-index: 10;
    box-shadow: 0 0 30px rgba(0,245,255,0.3) !important;
  }
  .terminal-header {
    background: var(--bg3); padding: 0.6rem 1rem;
    display: flex; align-items: center; gap: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .t-dot { width: 12px; height: 12px; border-radius: 50%; }
  .t-dot.r { background: #ff5f57; }
  .t-dot.y { background: #ffbd2e; }
  .t-dot.g { background: #28ca41; }
  .terminal-title {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.75rem; color: var(--muted); margin-left: 0.5rem;
  }
  .terminal-body { padding: 1.5rem; font-family: 'Share Tech Mono', monospace; font-size: 0.82rem; }
  .t-line { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .t-prompt { color: var(--accent3); }
  .t-cmd { color: var(--accent); }
  .t-output { color: var(--muted); padding-left: 1rem; }
  .t-key { color: var(--accent2); }
  .t-val { color: var(--accent3); }

  /* ── SKILLS ── */
  .skills-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    overflow: visible;
  }
  .skill-category {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 6px; padding: 1.5rem;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .skill-category:hover { border-color: rgba(0,245,255,0.3); box-shadow: var(--glow); }
  .skill-cat-title {
    font-family: 'Orbitron', monospace; font-size: 0.8rem;
    letter-spacing: 2px; color: var(--accent); margin-bottom: 1.25rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .skill-cat-icon { font-size: 1.1rem; vertical-align: middle; }
  .filter-btn i, .cert-filter-btn i { font-size: 0.9rem; vertical-align: middle; margin-right: 0.3rem; }
  .devicon-azure-plain { color: #0078d4; }
  .devicon-python-plain { color: #3776ab; }
  .devicon-tensorflow-original { color: #ff6f00; }
  .devicon-opencv-plain { color: #5c3ee8; }
  .devicon-mysql-plain { color: #4479a1; }
  .devicon-flask-original { color: var(--text); }
  .devicon-pandas-original { color: #150458; filter: brightness(3); }
  .devicon-keras-plain { color: #d00000; }
  .devicon-vscode-plain { color: #007acc; }
  .devicon-github-original { color: var(--text); }
  .skill-items { display: flex; flex-direction: column; gap: 0.75rem; }
  .skill-item {}
  .skill-info { display: flex; justify-content: space-between; margin-bottom: 0.3rem; }
  .skill-name { font-size: 0.85rem; color: var(--text); }
  .skill-pct { font-family: 'Share Tech Mono', monospace; font-size: 0.75rem; color: var(--accent); }
  .skill-bar { height: 3px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden; }
  .skill-fill {
    height: 100%; border-radius: 2px;
    background: linear-gradient(to right, var(--accent2), var(--accent));
    box-shadow: 0 0 6px rgba(0,245,255,0.4);
    width: 0; transition: width 1.2s cubic-bezier(0.22,1,0.36,1);
  }

  /* ── EDUCATION ── */
  .edu-timeline { position: relative; padding-left: 2rem; }
  .edu-timeline::before {
    content:''; position:absolute; left:0; top:0; bottom:0;
    width:1px; background: linear-gradient(to bottom, var(--accent), var(--accent2), transparent);
  }
  .edu-item {
    position: relative; margin-bottom: 2.5rem;
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 6px; padding: 1.5rem 1.75rem;
    transition: border-color 0.3s;
  }
  .edu-item { transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1); position: relative; z-index: 1; }
  .edu-item:hover { border-color: rgba(0,245,255,0.3); transform: scale(1.02); z-index: 10; box-shadow: 0 0 30px rgba(0,245,255,0.3); }
  .edu-item::before {
    content:''; position:absolute; left:-2.4rem; top:1.75rem;
    width:10px; height:10px; border-radius:50%;
    background: var(--accent); box-shadow: 0 0 10px var(--accent);
  }
  .edu-year {
    font-family: 'Share Tech Mono', monospace; font-size: 0.75rem;
    color: var(--accent); letter-spacing: 2px; margin-bottom: 0.4rem;
  }
  .edu-degree {
    font-family: 'Orbitron', monospace; font-size: 1rem;
    font-weight: 600; color: #fff; margin-bottom: 0.3rem;
  }
  .edu-inst { font-size: 0.9rem; color: var(--accent2); margin-bottom: 0.5rem; }
  .edu-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.7; }

  /* ── PROJECTS ── */
  .projects-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .project-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 6px; padding: 1.75rem;
    transition: all 0.3s; position: relative; overflow: hidden;
  }
  .project-card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:2px;
    background: linear-gradient(to right, var(--accent2), var(--accent));
    opacity: 0; transition: opacity 0.3s;
  }
  .project-card:hover { border-color: rgba(0,245,255,0.25); transform: scale(1.03); z-index: 10; box-shadow: 0 0 30px rgba(0,245,255,0.3); }
  .project-card:hover::before { opacity: 1; }
  .project-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; }
  .project-icon {
    width: 44px; height: 44px; border-radius: 6px;
    background: rgba(0,245,255,0.08); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem;
  }
  .project-links { display: flex; gap: 0.5rem; }
  .project-link {
    font-family: 'Share Tech Mono', monospace; font-size: 0.7rem;
    color: var(--muted); text-decoration: none; padding: 0.25rem 0.6rem;
    border: 1px solid var(--border); border-radius: 2px;
    transition: all 0.2s; letter-spacing: 1px;
  }
  .project-link:hover { color: var(--accent); border-color: var(--accent); }
  .project-name {
    font-family: 'Orbitron', monospace; font-size: 1rem;
    font-weight: 600; color: #fff; margin-bottom: 0.5rem;
  }
  .project-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.7; margin-bottom: 1.25rem; }
  .project-stack { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .stack-tag {
    font-family: 'Share Tech Mono', monospace; font-size: 0.7rem;
    padding: 0.2rem 0.6rem; background: rgba(124,58,237,0.12);
    border: 1px solid rgba(124,58,237,0.25); border-radius: 2px;
    color: var(--accent2);
  }

  /* ── CERTIFICATIONS ── */
  .certs-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .cert-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 6px; padding: 1.25rem 1.5rem;
    display: flex; gap: 1rem; align-items: flex-start;
    transition: all 0.3s;
  }
  .cert-card:hover { border-color: rgba(0,245,255,0.25); transform: scale(1.03); z-index: 10; box-shadow: 0 0 30px rgba(0,245,255,0.3); }
  .cert-card { transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1); position: relative; z-index: 1; }
  .cert-badge {
    width: 42px; height: 42px; flex-shrink: 0; border-radius: 6px;
    background: linear-gradient(135deg, var(--accent2), var(--accent));
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
  }
  .cert-name { font-size: 0.9rem; font-weight: 500; color: #fff; margin-bottom: 0.25rem; }
  .cert-issuer { font-family: 'Share Tech Mono', monospace; font-size: 0.75rem; color: var(--accent); margin-bottom: 0.2rem; }
  .cert-year { font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; }
    .cert-verify-btn {
    display: inline-block;
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.68rem; letter-spacing: 1px;
    color: var(--accent); text-decoration: none;
    padding: 0.2rem 0.65rem;
    border: 1px solid rgba(0,245,255,0.25);
    border-radius: 2px;
    transition: all 0.3s;
    margin-top: 0.4rem;
    }
    .cert-verify-btn:hover {
    background: rgba(0,245,255,0.08);
    border-color: var(--accent);
    box-shadow: 0 0 8px rgba(0,245,255,0.2);
    }
  /* ── INTERNSHIPS ── */
.intern-list { display: flex; flex-direction: column; gap: 1.5rem; }
.intern-card {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 6px; padding: 1.75rem;
  transition: all 0.3s; position: relative; overflow: hidden;
}
.intern-card::before {
  content:''; position:absolute; left:0; top:0; bottom:0; width:3px;
  background: linear-gradient(to bottom, var(--accent), var(--accent2));
  opacity: 0; transition: opacity 0.3s;
}
.intern-card:hover { border-color: rgba(0,245,255,0.25); box-shadow: var(--glow); }
.intern-card:hover::before { opacity: 1; }
.intern-top {
  display: flex; justify-content: space-between;
  align-items: flex-start; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;
}
.intern-left {}
.intern-role {
  font-family: 'Orbitron', monospace; font-size: 0.95rem;
  font-weight: 600; color: #fff; margin-bottom: 0.3rem;
}
.intern-company { font-size: 0.88rem; color: var(--accent); margin-bottom: 0.25rem; }
.intern-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; }
.intern-duration {
  font-family: 'Share Tech Mono', monospace; font-size: 0.72rem;
  color: var(--muted); letter-spacing: 1px;
}
.intern-badge {
  font-family: 'Share Tech Mono', monospace; font-size: 0.65rem;
  padding: 0.2rem 0.65rem; border-radius: 2px; letter-spacing: 1px;
}
.intern-badge.remote {
  color: var(--accent3); background: rgba(16,185,129,0.08);
  border: 1px solid rgba(16,185,129,0.25);
}
.intern-badge.current {
  color: var(--accent); background: rgba(0,245,255,0.08);
  border: 1px solid rgba(0,245,255,0.3);
  animation: pulse 1.5s ease-in-out infinite;
}
.intern-divider {
  height: 1px; background: var(--border); margin-bottom: 1rem;
}
.intern-points { display: flex; flex-direction: column; gap: 0.6rem; }
.intern-point {
  display: flex; gap: 0.75rem; align-items: flex-start;
  font-size: 0.85rem; color: var(--muted); line-height: 1.7;
}
.intern-point::before {
  content: '▸'; color: var(--accent2); flex-shrink: 0;
  margin-top: 0.1rem; font-size: 0.75rem;
}
.intern-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
.intern-tag {
  font-family: 'Share Tech Mono', monospace; font-size: 0.68rem;
  padding: 0.2rem 0.6rem;
  background: rgba(0,245,255,0.05);
  border: 1px solid rgba(0,245,255,0.15);
  border-radius: 2px; color: var(--accent);
}
/* ── PROJECT FILTERS ── */
  .filter-bar {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin-bottom: 2.5rem;
  }
  .filter-btn {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.75rem; letter-spacing: 1.5px;
    padding: 0.45rem 1.2rem;
    border-radius: 50px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.3s;
    outline: none;
  }
  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0,245,255,0.05);
  }
  .filter-btn.active {
    border-color: var(--accent);
    color: #000;
    background: var(--accent);
    box-shadow: 0 0 16px rgba(0,245,255,0.5);
    font-weight: 600;
  }
  .project-card {
    transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
    position: relative; z-index: 1;
  }
  .project-card.hidden {
    display: none;
  }

  /* ── CERT FILTERS ── */
  .cert-filter-bar {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .cert-filter-btn {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.75rem; letter-spacing: 1.5px;
    padding: 0.45rem 1.2rem;
    border-radius: 50px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.3s;
    outline: none;
  }
  .cert-filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0,245,255,0.05);
  }
  .cert-filter-btn.active {
    border-color: var(--accent);
    color: #000;
    background: var(--accent);
    box-shadow: 0 0 16px rgba(0,245,255,0.5);
    font-weight: 600;
  }
  .cert-card.hidden { display: none; }

  /* ── FUTURE PROJECTS ── */
  .future-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .future-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 6px; padding: 1.5rem;
    position: relative; overflow: hidden;
    transition: all 0.3s;
  }
  .future-card:hover { border-color: rgba(124,58,237,0.4); transform: scale(1.03); z-index: 10; box-shadow: 0 0 30px rgba(124,58,237,0.35); }
  .future-card { transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1) !important; position: relative; z-index: 1; }
  .future-status {
    font-family: 'Share Tech Mono', monospace; font-size: 0.72rem;
    letter-spacing: 1px; margin-bottom: 0.75rem;
    display: inline-flex; align-items: center; gap: 0;
    border-radius: 3px; overflow: hidden;
  }
  .status-decorator {
    padding: 0.25rem 0.5rem;
    font-size: 0.7rem;
  }
  .status-dot { display: none; }
  .status-dot.planning ~ span,
  .status-dot.research ~ span,
  .status-dot.ideation ~ span { display: none; }
  .future-status.planning-tag {
    background: rgba(124,58,237,0.12);
    border: 1px solid rgba(124,58,237,0.3);
    color: var(--accent2);
  }
  .future-status.research-tag {
    background: rgba(245,158,11,0.1);
    border: 1px solid rgba(245,158,11,0.3);
    color: #f59e0b;
  }
  .future-status.ideation-tag {
    background: rgba(16,185,129,0.1);
    border: 1px solid rgba(16,185,129,0.3);
    color: var(--accent3);
  }
  .future-title { font-family: 'Orbitron', monospace; font-size: 0.9rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem; }
  .future-desc { font-size: 0.82rem; color: var(--muted); line-height: 1.7; }

  /* ── BLOG ── */
  .blog-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .blog-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 6px; padding: 1.5rem 1.75rem;
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 2rem; transition: all 0.3s; text-decoration: none;
    cursor: pointer;
  }
  .blog-card:hover { border-color: rgba(0,245,255,0.25); box-shadow: var(--glow); }
  .blog-meta { display: flex; gap: 1rem; margin-bottom: 0.5rem; align-items: center; }
  .blog-cat {
    font-family: 'Share Tech Mono', monospace; font-size: 0.7rem;
    color: var(--accent2); letter-spacing: 1px;
  }
  .blog-date { font-family: 'Share Tech Mono', monospace; font-size: 0.7rem; color: var(--muted); }
  .blog-title { font-size: 0.95rem; font-weight: 500; color: #fff; margin-bottom: 0.4rem; }
  .blog-excerpt { font-size: 0.82rem; color: var(--muted); line-height: 1.6; }
  .blog-arrow {
    font-family: 'Share Tech Mono', monospace;
    color: var(--accent); font-size: 1.2rem; flex-shrink: 0;
    transition: transform 0.3s;
  }
  .blog-card:hover .blog-arrow { transform: translateX(4px); }

  /* ── CONTACT ── */
  .contact-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4rem; align-items: start;
  }
  .contact-info h3 {
    font-family: 'Orbitron', monospace; font-size: 1rem;
    color: var(--accent); margin-bottom: 1rem; letter-spacing: 2px;
  }
  .contact-info p { color: var(--muted); font-size: 0.9rem; line-height: 1.8; margin-bottom: 2rem; }
  .contact-links { display: flex; flex-direction: column; gap: 0.75rem; }
  .contact-link {
    display: flex; align-items: center; gap: 1rem;
    color: var(--muted); text-decoration: none; font-size: 0.9rem;
    padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: 4px;
    transition: all 0.3s; font-family: 'Share Tech Mono', monospace; font-size: 0.82rem;
  }
  .contact-link:hover { color: var(--accent); border-color: var(--accent); background: rgba(0,245,255,0.04); }
  .contact-link-icon { font-size: 1.1rem; display:flex; align-items:center; }
  .contact-link-icon svg { width:18px; height:18px; fill:currentColor; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-label {
    font-family: 'Share Tech Mono', monospace; font-size: 0.72rem;
    color: var(--accent); letter-spacing: 2px;
  }
  .form-input, .form-textarea {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 4px; padding: 0.75rem 1rem;
    color: var(--text); font-family: 'Inter', sans-serif; font-size: 0.9rem;
    outline: none; transition: border-color 0.3s;
    resize: vertical;
  }
  .form-input:focus, .form-textarea:focus { border-color: rgba(0,245,255,0.4); }
  .form-input::placeholder, .form-textarea::placeholder { color: var(--muted); }
  .form-submit {
    font-family: 'Share Tech Mono', monospace;
    background: linear-gradient(135deg, var(--accent2), var(--accent));
    color: #000; border: none; border-radius: 2px;
    padding: 0.85rem 2rem; font-size: 0.85rem; letter-spacing: 2px;
    cursor: pointer; font-weight: 600; transition: all 0.3s;
    box-shadow: 0 0 20px rgba(0,245,255,0.2);
    align-self: flex-start;
  }
  .form-submit:hover { box-shadow: 0 0 30px rgba(0,245,255,0.4); transform: translateY(-2px); }

  /* ── FOOTER ── */
  footer {
    position: relative; z-index: 1;
    border-top: 1px solid var(--border);
    padding: 2rem 3rem;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem;
  }
  .footer-logo {
    font-family: 'Orbitron', monospace; font-size: 0.9rem;
    color: var(--accent); letter-spacing: 2px;
  }
  .footer-copy { font-family: 'Share Tech Mono', monospace; font-size: 0.75rem; color: var(--muted); }

  /* ── ANIMATIONS ── */
  .fade-up {
    opacity: 0; transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .fade-up.visible { opacity: 1; transform: translateY(0); }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    section { padding: 5rem 1.5rem; }
    #hero { padding: 5rem 1.5rem 3rem; }
    .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-stats { gap: 2rem; }
    footer { padding: 1.5rem; }
  }
  /* ── LEETCODE CARD ── */
.code-card {
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 6px; padding: 1.75rem;
  display: flex; flex-direction: column; gap: 1.25rem;
  transition: all 0.3s; max-width: 480px;
}
.code-card:hover { border-color: rgba(0,245,255,0.3); transform: scale(1.03); z-index: 10; box-shadow: 0 0 30px rgba(0,245,255,0.3); }
.code-card { transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1); position: relative; z-index: 1; }
.code-card-title {
  font-family: 'Orbitron', monospace; font-size: 0.85rem;
  color: var(--accent); letter-spacing: 2px;
  display: flex; align-items: center; gap: 0.6rem;
}
.code-repo {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.85rem 1rem;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border);
  border-radius: 4px; text-decoration: none;
  transition: all 0.3s; gap: 1rem;
}
.code-repo:hover { border-color: var(--accent); background: rgba(0,245,255,0.05); }
.code-repo-left { display: flex; align-items: center; gap: 0.75rem; }
.code-repo-icon {
  width: 36px; height: 36px; border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem; flex-shrink: 0;
}
.code-repo-icon.py { background: rgba(0,245,255,0.08); border: 1px solid rgba(0,245,255,0.2); }
.code-repo-icon.sql { background: rgba(124,58,237,0.08); border: 1px solid rgba(124,58,237,0.2); }
.code-repo-name {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.82rem; color: var(--text); margin-bottom: 0.2rem;
}
.code-repo-desc { font-size: 0.75rem; color: var(--muted); }
.code-repo-arrow {
  font-family: 'Share Tech Mono', monospace;
  color: var(--accent); font-size: 1rem;
  transition: transform 0.3s; flex-shrink: 0;
}
.code-repo:hover .code-repo-arrow { transform: translateX(4px); }
.code-daily-badge {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-family: 'Share Tech Mono', monospace; font-size: 0.72rem;
  color: var(--accent3); letter-spacing: 1.5px;
  padding: 0.35rem 0.85rem;
  border: 1px solid rgba(16,185,129,0.3);
  border-radius: 2px; background: rgba(16,185,129,0.06);
  width: fit-content;
}
.daily-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--accent3);
  box-shadow: 0 0 6px var(--accent3);
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{ opacity:1; transform:scale(1); } 50%{ opacity:0.5; transform:scale(0.8); } }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--accent2); border-radius: 2px; }

  /* ── SCANLINE EFFECT (subtle) ── */
  body::after {
    content:''; position:fixed; inset:0; z-index:999; pointer-events:none;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.015) 2px, rgba(0,0,0,0.015) 4px);
  }
</style>
</head>
<body>

