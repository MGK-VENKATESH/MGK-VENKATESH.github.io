<script>
    // ── CURSOR GLOW EFFECT ──
// ── AURORA LIVE WALLPAPER EFFECT ──
const canvas = document.getElementById('aurora-canvas');
const ctx = canvas.getContext('2d');

let mouseX = window.innerWidth / 2;
let mouseY = window.innerHeight / 2;
let targetX = mouseX, targetY = mouseY;
let time = 0;
const SPEED = 0.99;
let globalAlpha = 1;
let isMoving = false;
let idleTimer = null;

function resizeCanvas() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

document.addEventListener('mousemove', (e) => {
  targetX = e.clientX;
  targetY = e.clientY;
  isMoving = true;
  globalAlpha = 1;
  clearTimeout(idleTimer);
  idleTimer = setTimeout(() => {
    isMoving = false;
  }, 2000);
});

window.addEventListener('scroll', () => {
  isMoving = true;
  globalAlpha = 1;
  clearTimeout(idleTimer);
  idleTimer = setTimeout(() => {
    isMoving = false;
  }, 2000);
});

const colors = [
  { r: 0,   g: 255, b: 255 },  // pure cyan
  { r: 180, g: 0,   b: 255 },  // pure violet
  { r: 0,   g: 255, b: 150 },  // pure neon green
  { r: 0,   g: 150, b: 255 },  // pure electric blue
];
function lerp(a, b, t) { return a + (b - a) * t; }

function drawAurora() {
  mouseX = lerp(mouseX, targetX, SPEED);
  mouseY = lerp(mouseY, targetY, SPEED);
  time += 0.008;

  if (!isMoving) {
    globalAlpha = Math.max(0, globalAlpha - 0.033);
  } else {
    globalAlpha = Math.min(1, globalAlpha + 0.15);
  }
  if (globalAlpha <= 0) {
    requestAnimationFrame(drawAurora);
    return;
  }
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.globalAlpha = globalAlpha;

  const blobs = [
    {
      x: mouseX + Math.sin(time * 1.2) * 30,
      y: mouseY + Math.cos(time * 0.9) * 20,
      r: 70, color: colors[0], alpha: 0.55
    },
    {
      x: mouseX + Math.cos(time * 0.8) * 35,
      y: mouseY + Math.sin(time * 1.1) * 25,
      r: 60, color: colors[1], alpha: 0.50
    },
    {
      x: mouseX + Math.sin(time * 1.5 + 1) * 22,
      y: mouseY + Math.cos(time * 1.3 + 1) * 28,
      r: 50, color: colors[2], alpha: 0.45
    },
    {
      x: mouseX + Math.cos(time * 0.6 + 2) * 40,
      y: mouseY + Math.sin(time * 0.7 + 2) * 30,
      r: 65, color: colors[3], alpha: 0.48
    },
  ];

  blobs.forEach(blob => {
    const grad = ctx.createRadialGradient(
      blob.x, blob.y, 0,
      blob.x, blob.y, blob.r
    );
    grad.addColorStop(0,   `rgba(${blob.color.r},${blob.color.g},${blob.color.b},${blob.alpha})`);
    grad.addColorStop(0.4, `rgba(${blob.color.r},${blob.color.g},${blob.color.b},${blob.alpha * 0.5})`);
    grad.addColorStop(1,   `rgba(${blob.color.r},${blob.color.g},${blob.color.b},0)`);

    ctx.beginPath();
    ctx.arc(blob.x, blob.y, blob.r, 0, Math.PI * 2);
    ctx.fillStyle = grad;
    ctx.fill();
  });
  ctx.globalAlpha = 1;
  requestAnimationFrame(drawAurora);
}
drawAurora();
// ── TYPED TEXT ANIMATION ──
const phrases = [
  "FastAPI & Flask APIs",
  "Azure Cloud Solutions",
  "Machine Learning",
  "Computer Vision",
  "Data Science & Analytics",
  "AI-Integrated Applications"
];

const roles = [
  "Python Developer",
  "Software Developer",
  "Junior Python Engineer",
  "Backend Developer",
  "ML Engineer",
  "Azure Cloud Developer",
  "Junior Software Engineer",
  "Data Science Engineer"
];

let phraseIdx = 0, charIdx = 0, deleting = false;
function typeEffect() {
  const el = document.getElementById('typed');
  if (!el) return;
  const current = phrases[phraseIdx];
  if (!deleting) {
    el.textContent = current.slice(0, charIdx + 1);
    charIdx++;
    if (charIdx === current.length) { deleting = true; setTimeout(typeEffect, 1800); return; }
    setTimeout(typeEffect, 80);
  } else {
    el.textContent = current.slice(0, charIdx - 1);
    charIdx--;
    if (charIdx === 0) { deleting = false; phraseIdx = (phraseIdx + 1) % phrases.length; }
    setTimeout(typeEffect, 40);
  }
}
typeEffect();

let roleIdx = 0, roleCharIdx = 0, roleDeleting = false;
function typeRoles() {
  const el = document.getElementById('typed2');
  if (!el) return;
  const current = roles[roleIdx];
  if (!roleDeleting) {
    el.textContent = current.slice(0, roleCharIdx + 1);
    roleCharIdx++;
    if (roleCharIdx === current.length) { roleDeleting = true; setTimeout(typeRoles, 2000); return; }
    setTimeout(typeRoles, 80);
  } else {
    el.textContent = current.slice(0, roleCharIdx - 1);
    roleCharIdx--;
    if (roleCharIdx === 0) { roleDeleting = false; roleIdx = (roleIdx + 1) % roles.length; }
    setTimeout(typeRoles, 40);
  }
}
typeRoles();

// ── SCROLL ANIMATIONS ──
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('visible'); }
  });
}, { threshold: 0.12, rootMargin: '0px 0px -50px 0px' });
document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

// ── SKILL BAR ANIMATION ──
const skillObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.querySelectorAll('.skill-fill').forEach(bar => {
        const w = bar.getAttribute('data-width');
        bar.style.width = w + '%';
      });
    }
  });
}, { threshold: 0.3 });
document.querySelectorAll('.skill-category').forEach(el => skillObserver.observe(el));

// ── FORM SUBMIT ──
function handleFormSubmit() {
  const inputs = document.querySelectorAll('.form-input, .form-textarea');
  let valid = true;
  inputs.forEach(i => { if (!i.value.trim()) valid = false; });
  if (!valid) { alert('Please fill in all fields!'); return; }
  const btn = document.querySelector('.form-submit');
  btn.textContent = '✓ MESSAGE SENT!';
  btn.style.background = 'var(--accent3)';
  setTimeout(() => {
    btn.textContent = 'SEND MESSAGE →';
    btn.style.background = '';
    inputs.forEach(i => i.value = '');
  }, 3000);
}

// Apply default filter on load
document.querySelectorAll('.project-card').forEach(card => {
  const cats = card.getAttribute('data-category') || '';
  if (!cats.includes('ml')) {
    card.classList.add('hidden');
  }
});
// Set active style on first button on load
document.querySelector('.filter-btn[data-filter="ml"]').classList.add('active');

// ── CERT FILTER ──
document.querySelectorAll('.cert-card').forEach(card => {
  const cats = card.getAttribute('data-cert-category') || '';
  if (!cats.includes('python')) card.classList.add('hidden');
});
document.querySelector('.cert-filter-btn[data-cert-filter="python"]').classList.add('active');

document.querySelectorAll('.cert-filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.cert-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.getAttribute('data-cert-filter');
    document.querySelectorAll('.cert-card').forEach(card => {
      const cats = card.getAttribute('data-cert-category') || '';
      if (filter === 'all' || cats.includes(filter)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  });
});
// ── PROJECT FILTER ──
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.getAttribute('data-filter');
    document.querySelectorAll('.project-card').forEach(card => {
      const cats = card.getAttribute('data-category') || '';
      if (filter === 'all' || cats.includes(filter)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  });
});

// ── ACTIVE NAV HIGHLIGHT ──
const sections = document.querySelectorAll('section[id]');
const navLinks = document.querySelectorAll('.nav-links a');
window.addEventListener('scroll', () => {
  let current = '';
  sections.forEach(s => {
    if (window.scrollY >= s.offsetTop - 200) current = s.getAttribute('id');
  });
  navLinks.forEach(a => {
    a.style.color = a.getAttribute('href') === '#' + current ? 'var(--accent)' : '';
  });
});

// ── TERMINAL BACKGROUND ANIMATION ──
(function() {
  const canvas = document.getElementById('bgCanvas');
  const wrap = document.getElementById('termWrap');
  if (!canvas || !wrap) return;
  const ctx = canvas.getContext('2d');

  function resize() {
    canvas.width = wrap.offsetWidth;
    canvas.height = wrap.offsetHeight;
  }
  resize();

  const snippets = [
    'import asyncio','from fastapi import FastAPI','@app.get("/health")',
    'def predict(x):','async def main():','return {"status": 200}',
    'pd.DataFrame()','np.array([])','model.fit(X,y)','torch.tensor()',
    'class MLModel:','if __name__=="__main__":','yield db.session',
    'await response.json()','sklearn.metrics','blob_client.upload()',
    'cv2.imread()','mediapipe.solutions','CosmosClient(url)',
    'BlobServiceClient','requests.get(url)','json.dumps(data)',
    'logging.info()','os.environ.get()','# TODO: optimize',
    'try:\n  pass','except Exception as e:','with open(f) as fp:',
    'list(map(fn, xs))','[x for x in data]','lambda x: x*2',
  ];

  const COLS = [
    'rgba(0,245,255,',
    'rgba(124,58,237,',
    'rgba(16,185,129,',
    'rgba(245,158,11,',
  ];

  class FloatingSnippet {
    constructor() { this.reset(true); }
    reset(init) {
      this.text = snippets[Math.floor(Math.random()*snippets.length)];
      this.x = 20 + Math.random() * (canvas.width - 40);
      this.y = init ? Math.random() * canvas.height : canvas.height + 20;
      this.speed = 0.12 + Math.random() * 0.25;
      this.opacity = 0;
      this.maxOpacity = 0.14 + Math.random() * 0.14;
      this.size = 9 + Math.floor(Math.random() * 3);
      this.color = COLS[Math.floor(Math.random()*COLS.length)];
      this.phase = Math.random() * Math.PI * 2;
      this.drift = (Math.random()-0.5) * 0.3;
      this.life = 0;
      this.maxLife = 300 + Math.random() * 400;
    }
    update() {
      this.life++;
      this.y -= this.speed;
      this.x += Math.sin(this.phase + this.life*0.018) * this.drift;
      const fadeIn = Math.min(1, this.life / 80);
      const fadeOut = Math.max(0, 1 - (this.life - (this.maxLife-80)) / 80);
      this.opacity = this.maxOpacity * Math.min(fadeIn, fadeOut);
      if (this.life > this.maxLife) this.reset(false);
    }
    draw() {
      ctx.save();
      ctx.font = `${this.size}px 'Share Tech Mono','Courier New',monospace`;
      ctx.fillStyle = `${this.color}${this.opacity.toFixed(3)})`;
      ctx.fillText(this.text, this.x, this.y);
      ctx.restore();
    }
  }

  class MatrixDrop {
    constructor() { this.reset(true); }
    reset(init) {
      this.x = Math.floor(Math.random() * (canvas.width / 14)) * 14 + 7;
      this.y = init ? Math.random() * canvas.height : -20;
      this.speed = 0.8 + Math.random() * 1.4;
      this.len = 4 + Math.floor(Math.random() * 8);
      this.chars = [];
      for (let i = 0; i < this.len; i++) {
        const pool = '0123456789ABCDEF{}[]()_=<>|@#$%&*';
        this.chars.push(pool[Math.floor(Math.random()*pool.length)]);
      }
      this.opacity = 0.11 + Math.random() * 0.11;
    }
    update() {
      this.y += this.speed;
      if (this.y > canvas.height + this.len * 14) this.reset(false);
      if (Math.random() < 0.04) {
        const pool = '0123456789ABCDEF{}[]()_=<>|@#$%&*';
        const i = Math.floor(Math.random()*this.chars.length);
        this.chars[i] = pool[Math.floor(Math.random()*pool.length)];
      }
    }
    draw() {
      ctx.font = '11px monospace';
      for (let i = 0; i < this.chars.length; i++) {
        const fade = (i / this.chars.length);
        const a = this.opacity * (i === this.chars.length-1 ? 1 : fade * 0.6);
        ctx.fillStyle = `rgba(0,245,255,${a.toFixed(3)})`;
        ctx.fillText(this.chars[i], this.x, this.y - i * 13);
      }
    }
  }

  const drops = Array.from({length: 28}, () => new MatrixDrop());
  const floats = Array.from({length: 18}, () => new FloatingSnippet());

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drops.forEach(d => { d.update(); d.draw(); });
    floats.forEach(f => { f.update(); f.draw(); });
    requestAnimationFrame(draw);
  }
  draw();
  window.addEventListener('resize', resize);

  
})();
</script>
</body>
</html>